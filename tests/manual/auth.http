@endpointRegister = http://localhost:3000/api/v1/auth/register
@endpointLogin = http://localhost:3000/api/v1/auth/login

@endpointMe = http://localhost:3000/api/v1/auth/me

###
POST {{endpointRegister}} HTTP/1.1
content-type: application/json

{
    "name": "Eliska",
    "email": "eliska1@email.cz",
    "password": "1234566"
}


###
# @name login
POST {{endpointLogin}} HTTP/1.1
content-type: application/json

{
    "email": "eliska1@email.cz",
    "password": "1234566"
}

###
@accessToken = {{login.response.body.token}}

GET {{endpointMe}} HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}
